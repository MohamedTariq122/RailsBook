<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-[#D30001]"><%= @post.title %></h1>
    <div class="space-x-2">
      <%= link_to 'Edit', edit_post_path(@post), class: "bg-[#D30001] hover:bg-[#B30001] text-white font-bold py-2 px-4 rounded" %>
      <%= link_to 'Back', posts_path, class: "text-[#D30001] hover:text-[#B30001]" %>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="text-sm text-gray-500 mb-4">
      Posted by: <%= @post.user.is_a?(User) ? @post.user.email : "Guest-#{@post.user.mac_address[0..5]}" %>
      <span class="mx-2">•</span>
      <%= time_ago_in_words(@post.created_at) %> ago
    </div>

    <div class="prose max-w-none mb-6 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition duration-200">
      <div class="text-gray-800 leading-relaxed">
        <%= simple_format @post.content %>
      </div>
    </div>
    
    <div class="mt-8 border-t pt-6">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 flex items-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        Comments (<%= @post.comments_count %>)
      </h2>
      
      <div class="space-y-4">
        <% @post.comments.each do |comment| %>
          <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition duration-200">
            <div class="flex items-center text-sm text-gray-600 mb-2">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
              </svg>
              <%= comment.user.is_a?(User) ? comment.user.email : "Guest-#{comment.user.mac_address[0..5]}" %>
              <span class="mx-2">•</span>
              <%= time_ago_in_words(comment.created_at) %> ago
            </div>
            <div class="text-gray-800 pl-6"><%= simple_format comment.content %></div>
          </div>
        <% end %>
      </div>

      <div class="mt-8 bg-gray-50 rounded-lg p-6">
        <h3 class="text-xl font-bold mb-4 text-gray-800">Add a Comment</h3>
        <%= form_with(model: [ @post, @post.comments.build ], local: true) do |form| %>
          <div class="mb-4">
            <%= form.label :content, "Your comment", class: "block text-gray-700 font-medium mb-2" %>
            <%= form.text_area :content, rows: 4, 
                class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
                placeholder: "Write your comment here..." %>
          </div>
          <div>
            <%= form.submit 'Post Comment', 
                class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg transition duration-200 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @post.editable_by?(current_user) %>
      <div class="flex space-x-4 mt-6">
        <%= link_to 'Edit', edit_post_path(@post), class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
        <%= button_to 'Delete', post_path(@post), method: :delete, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded", form: { data: { turbo_confirm: 'Are you sure you want to delete this post?' } } %>
      </div>
    <% end %>
    
    <%= link_to 'Back to Posts', posts_path, class: "inline-block mt-4 text-blue-600 hover:text-blue-800" %>
  </div>
</div>
